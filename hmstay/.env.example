# Copy thành .env rồi đổi giá trị. KHÔNG commit .env
POSTGRES_PASSWORD=doi-mat-khau-admin-dai-va-ngau-nhien
APP_DB_PASSWORD=doi-mat-khau-app-dai-va-ngau-nhien

# App Next.js (dùng role app_user, KHÔNG dùng hmstay_admin)
DATABASE_URL=postgres://app_user:doi-mat-khau-app-dai-va-ngau-nhien@127.0.0.1:5432/hmstay
AUTH_SECRET=chuoi-ngau-nhien-it-nhat-32-ky-tu   # openssl rand -base64 32
UPLOAD_DIR=./uploads
COOKIE_SECURE=false                              # đặt true khi chạy sau HTTPS

# Chạy bằng docker compose trên VPS: compose tự đặt DATABASE_URL (host db) và COOKIE_SECURE
# cho service web; chỉ cần POSTGRES_PASSWORD, APP_DB_PASSWORD, AUTH_SECRET ở trên và DOMAIN dưới đây.
DOMAIN=hmstay.example.com

# Quên mật khẩu: link trong email dùng APP_URL; gửi mail qua SMTP.
# Không điền SMTP_HOST thì ở production sẽ KHÔNG gửi được email.
APP_URL=https://hmstay.example.com
SMTP_HOST=
SMTP_PORT=587          # 587 = STARTTLS, 465 = SSL
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HMStay <no-reply@hmstay.example.com>"
