# Sao chép thành .env trên server rồi điền. KHÔNG commit file .env.
# ── Bắt buộc ──
APP_URL="https://dalat.example.com"      # địa chỉ công khai (https). Đổi giá trị này thì phải build lại (--build)
POSTGRES_PASSWORD=""                     # openssl rand -hex 24
BETTER_AUTH_SECRET=""                    # openssl rand -base64 32
WEB_PORT=3200                            # cổng localhost cho nginx/Caddy (hmstay dùng 3100)

# ── Cloudflare R2 (ảnh căn + ảnh bill) ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""                         # https://<domain công khai của bucket>

# ── Email (SMTP) — để gửi link quên mật khẩu qua email. Bỏ trống thì chỉ gửi qua Telegram ──
SMTP_HOST=""                             # ví dụ smtp.gmail.com / smtp.sendgrid.net
SMTP_PORT=587                            # 465 = SSL, 587 = STARTTLS
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Đà Lạt Homestay <no-reply@dalat.example.com>"

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""               # openssl rand -hex 24

# ── Web Push (npx web-push generate-vapid-keys) ──
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""          # = VAPID_PUBLIC_KEY (được đóng vào bundle lúc build)

# ── Đăng nhập Google (tuỳ chọn) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Giám sát (dịch vụ `monitor`) ──
ADMIN_TELEGRAM_CHAT_ID=""                # nhắn /id cho bot để lấy; nhận cảnh báo sự cố/hồi phục
ADMIN_EMAIL=""                           # (tuỳ chọn) nhận cảnh báo qua email, cần SMTP_*
HEARTBEAT_URL=""                         # URL ping của healthchecks.io / Better Stack: ngừng ping = VPS hoặc Docker sập
MONITOR_HOST_LABEL="dalat"               # tên hiện trong tin cảnh báo (nếu có nhiều máy)

# ── Sao lưu ra ngoài VPS (dịch vụ `backup-sync`) ──
# Tạo 1 bucket R2 RIÊNG, KHÔNG công khai (khác R2_BUCKET) rồi tạo API token có quyền Object Read & Write cho bucket đó.
BACKUP_R2_BUCKET=""
# Mặc định dùng chung R2_ACCOUNT_ID/R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY; chỉ đặt nếu dùng token riêng:
BACKUP_R2_ACCESS_KEY_ID=""
BACKUP_R2_SECRET_ACCESS_KEY=""
BACKUP_ENCRYPTION_KEY=""                 # >= 16 ký tự (openssl rand -base64 24). MẤT KHOÁ NÀY LÀ KHÔNG KHÔI PHỤC ĐƯỢC. Hãy cất ở nơi khác
BACKUP_RETENTION_DAYS=30
