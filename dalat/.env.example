# ── Database (docker-compose publishes Postgres on host port 5433) ──
DATABASE_URL="postgresql://dalat:dalat@localhost:5433/dalat?schema=public"
POSTGRES_USER=dalat
POSTGRES_PASSWORD=dalat
POSTGRES_DB=dalat

# ── Redis (BullMQ) ──
REDIS_URL="redis://localhost:6380"

# ── Auth (Better Auth) ──
# Tạo bằng: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Đăng nhập Google (tuỳ chọn)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Cloudflare R2 (S3-compatible) ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ── VietQR (mặc định https://img.vietqr.io, chỉ đổi khi tự host/giả lập) ──
# VIETQR_BASE_URL=""

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=""

# ── Timezone ──
TZ=Asia/Ho_Chi_Minh
